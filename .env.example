# ---------------------------------------------------------------
# Clinicyza Portals — environment variables
# Copy to .env.local. NEXT_PUBLIC_* values are visible in the browser — no secrets.
# ---------------------------------------------------------------

# Browser calls go to this app's own /api/v1, which next.config.mjs forwards to BACKEND_URL.
# Keep it relative so auth cookies stay on the portals domain.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# clinicyza-server base URL (no trailing slash, no /api) — used by the rewrite, server-side only
BACKEND_URL=http://localhost:8000

# Public marketing website (clinicyza-web)
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3001

# This portals app
NEXT_PUBLIC_PORTALS_URL=http://localhost:3002

# Live updates from the realtime server (clinicyza-server `npm run dev`, port 8001).
# Keep "false" on Vercel until the realtime server is hosted.
NEXT_PUBLIC_REALTIME_ENABLED=false
